# Corpus v2 traffic profile (TP06 OneToMany) — generated from corpus_v1. Mobility unchanged; Events* and Group*.msgTtl overridden.
# =========================================================
# R1 - Rural sparse SPMM on trails
# Large world, few nodes (sparse rural).
# Levers: MovementModel.worldSize large, nrofHosts low, ShortestPathMapBasedMovement on sparse trails.
# =========================================================

Scenario.name = R1_Rural_SparseSPMM__TP06_OneToMany
Scenario.simulateConnections = true
Scenario.updateInterval = 0.1
Scenario.endTime = 43200
MovementModel.rngSeed = 29
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/NuuksioSparseTrails/roads.wkt

# R1 lever: large world (rural)
MovementModel.worldSize = 2470, 2565

Group.movementModel = ShortestPathMapBasedMovement
Group.router = EpidemicRouter
# R1 lever: few nodes
Group.nrofHosts = 25
Group.bufferSize = 50M
Group.nrofInterfaces = 1
Group.interface1 = bt0
Group.speed = 1.0, 2.5
Group.waitTime = 120, 600

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 80

Scenario.nrofHostGroups = 1
Group1.groupID = r

Group.msgTtl = 7200

Events.nrof = 1
Events1.class = MessageEventGenerator
Events1.interval = 30, 60
Events1.size = 10k, 100k
Events1.hosts = 0, 1
Events1.tohosts = 1, 25
Events1.prefix = M

Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport
