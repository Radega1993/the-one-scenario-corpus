# Corpus traffic profile (TP05 CriticalTTL) — generated from base; mobility unchanged; Events* and Group*.msgTtl overridden.
# =========================================================
# D1 - Shelter hotspots and emergency mobility
# Civilians on shortest-path movement near shelters; emergency/mule routes connect zones.
# Levers: ShortestPathMapBasedMovement (dense shelter areas) + MapRouteMovement (mules).
# =========================================================
# =========================================================
# D1 - Shelter hotspots and emergency mobility
# Civilians on shortest-path movement near shelters; emergency/mule routes connect zones.
# Levers: ShortestPathMapBasedMovement (dense shelter areas) + MapRouteMovement (mules).
# =========================================================

Scenario.name = D1_ShelterHotspots_EmergencyMobility__TP05_CriticalTTL
Scenario.simulateConnections = true
Scenario.updateInterval = 0.1
Scenario.endTime = 43200
MovementModel.rngSeed = 37
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/HelsinkiDisrupted/roads.wkt

MovementModel.worldSize = 2067, 2206

Group.router = EpidemicRouter
Group.bufferSize = 50M
Group.nrofInterfaces = 1
Group.interface1 = bt0

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 10

Scenario.nrofHostGroups = 5

# Shelter A — civilians (map-aware, slower, frequent pauses)
Group1.groupID = sA
Group1.nrofHosts = 32
Group1.movementModel = ShortestPathMapBasedMovement
Group1.speed = 0.4, 1.0
Group1.waitTime = 30, 180

# Shelter B
Group2.groupID = sB
Group2.nrofHosts = 24
Group2.movementModel = ShortestPathMapBasedMovement
Group2.speed = 0.4, 1.0
Group2.waitTime = 30, 180

# Shelter C
Group3.groupID = sC
Group3.nrofHosts = 14
Group3.movementModel = ShortestPathMapBasedMovement
Group3.speed = 0.4, 1.0
Group3.waitTime = 30, 180

# Emergency responders on primary route
Group4.groupID = em
Group4.nrofHosts = 4
Group4.movementModel = MapRouteMovement
Group4.routeFile = data/HelsinkiDisrupted/A_emergency_route.wkt
Group4.routeType = 1
Group4.speed = 1.2, 2.2
Group4.waitTime = 0, 45
Group4.bufferSize = 80M

# Mule / aid shuttles on secondary route
Group5.groupID = mu
Group5.nrofHosts = 6
Group5.movementModel = MapRouteMovement
Group5.routeFile = data/HelsinkiDisrupted/B_mule_route.wkt
Group5.routeType = 1
Group5.speed = 1.0, 2.0
Group5.waitTime = 0, 60
Group5.bufferSize = 100M

Group.msgTtl = 5

Events.nrof = 1
Events1.class = MessageEventGenerator
Events1.interval = 60, 120
Events1.size = 10k, 100k
Events1.hosts = 0, 80
Events1.prefix = M

Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport
