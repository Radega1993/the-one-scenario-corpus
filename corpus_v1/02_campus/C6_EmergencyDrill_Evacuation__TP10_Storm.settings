# Corpus v2 traffic profile (TP10 Storm) — generated from corpus_v1. Mobility unchanged; Events* and Group*.msgTtl overridden.
# =========================================================
# C6 - Emergency drill / evacuation
# =========================================================

Scenario.name = C6_EmergencyDrill_Evacuation__TP10_Storm
Scenario.simulateConnections = true
Scenario.updateInterval = 0.5
Scenario.endTime = 7200
MovementModel.rngSeed = 20
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/KumpulaCampus/roads.wkt

MovementModel.worldSize = 1524, 1416

# Evacuation: ShortestPathMapBasedMovement on campus graph (speed 2–4 m/s, waitTime 0–10 s). Legacy LinearMovement keys removed.
Group.movementModel = ShortestPathMapBasedMovement
Group.router = EpidemicRouter
Group.nrofHosts = 80
Group.bufferSize = 50M
Group.nrofInterfaces = 1
Group.interface1 = bt0
# C8 lever: fast directional movement (evacuation)
Group.speed = 2.0, 4.0
Group.waitTime = 0, 10

# Line: from one side (entrance) toward far end (exit)
# 0 = random init on line, 1 = far end (evacuation target)

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 10

Scenario.nrofHostGroups = 1
Group1.groupID = v

Group.msgTtl = 60

Events.nrof = 1
Events1.class = MessageEventGenerator
Events1.interval = 5, 10
Events1.size = 100k, 500k
Events1.hosts = 0, 80
Events1.prefix = M

Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport
