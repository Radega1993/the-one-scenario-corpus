# Corpus v2 traffic profile (TP04 FewLarge) — generated from corpus_v1. Mobility unchanged; Events* and Group*.msgTtl overridden.
# =========================================================
# D6 - Short TTL critical
# Critical small messages with very short TTL (5–10 minutes).
# Levers: msgTtl 5–10 min (minutes units), small message sizes.
# =========================================================

Scenario.name = D6_ShortTtlCritical_5to10min__TP04_FewLarge
Scenario.simulateConnections = true
Scenario.updateInterval = 0.1
Scenario.endTime = 14400
MovementModel.rngSeed = 42
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/HelsinkiDisrupted/roads.wkt

# Diversificación estructural vs R5 (mantener grupo Disaster)
MovementModel.worldSize = 1711, 1874

Group.movementModel = ShortestPathMapBasedMovement
Group.router = EpidemicRouter
Group.nrofHosts = 54
Group.bufferSize = 45M

# D6 lever: 5–10 minute TTL (minutes)
Group.msgTtl = 14400

Group.nrofInterfaces = 1
Group.interface1 = bt0
Group.speed = 1.0, 3.0
Group.waitTime = 15, 150

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 35

Scenario.nrofHostGroups = 1
Group1.groupID = c

Events.nrof = 1
Events1.class = MessageEventGenerator
Events1.interval = 180, 300
Events1.size = 500k, 2M
Events1.hosts = 0, 54
Events1.prefix = M

Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport

