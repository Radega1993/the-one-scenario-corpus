# Corpus v1 traffic profile (TP05 CriticalTTL) — generated from base.
# Mobility and backbone events unchanged; Events1* and Group.msgTtl overridden.
# =========================================================
# D8 - Emergency backbone with intermittent bridges
# Two civilian/refugee partitions remain disconnected during
# the first half of the simulation. After t = 6 h, temporary
# backbone opportunities appear via externally scheduled CONN
# events on logical interface bb0 (up/down windows).
# Levers: ExternalEventsQueue + intermittent CONN on bb0.
# =========================================================

Scenario.name = D8_EmergencyBackbone_IntermittentBridges__TP05_CriticalTTL
Scenario.simulateConnections = true
Scenario.updateInterval = 0.1
Scenario.endTime = 43200
MovementModel.rngSeed = 44
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/HelsinkiDisrupted/roads.wkt

MovementModel.worldSize = 1711, 1874

Group.router = EpidemicRouter
Group.bufferSize = 50M
Group.nrofInterfaces = 2
Group.interface1 = bt0
Group.interface2 = bb0

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 10

# Logical backbone: range 0 disables proximity scan; links only via CONN events
bb0.type = SimpleBroadcastInterface
bb0.transmitSpeed = 2M
bb0.transmitRange = 0

Scenario.nrofHostGroups = 2

# Partition A (no roaming between partitions)
Group1.groupID = a
Group1.nrofHosts = 40
Group1.movementModel = ClusterMovement
Group1.clusterCenter = 342, 937
Group1.clusterRange = 112
Group1.speed = 0.4, 1.2
Group1.waitTime = 30, 240

# Partition B (no roaming between partitions)
Group2.groupID = b
Group2.nrofHosts = 40
Group2.movementModel = ClusterMovement
Group2.clusterCenter = 1369, 937
Group2.clusterRange = 112
Group2.speed = 0.4, 1.2
Group2.waitTime = 30, 240

Group.msgTtl = 5

Events.nrof = 2
Events1.class = MessageEventGenerator
Events1.interval = 60, 120
Events1.size = 10k, 100k
Events1.hosts = 0, 80
Events1.prefix = M

# Emergency backbone: intermittent gateway links after 6 hours
Events2.class = ExternalEventsQueue
Events2.nrofPreload = 100
Events2.filePath = scenarios/corpus_v1/05_disaster/D8_emergency_backbone_events.txt
Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport
