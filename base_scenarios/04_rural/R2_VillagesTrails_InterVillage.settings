# =========================================================
# R2 - Villages connected by trails
# Three local village groups on trail loops + inter-village patrol route.
# Levers: MapRouteMovement (village + patrol), no ClusterMovement.
# =========================================================

Scenario.name = R2_VillagesTrails_InterVillage
Scenario.simulateConnections = true
Scenario.updateInterval = 0.1
Scenario.endTime = 43200
MovementModel.rngSeed = 30
MapBasedMovement.nrofMapFiles = 1
MapBasedMovement.mapFile1 = data/NuuksioSparseTrails/roads.wkt

MovementModel.worldSize = 2470, 2565

Group.router = EpidemicRouter
Group.bufferSize = 50M
Group.nrofInterfaces = 1
Group.interface1 = bt0
Group.speed = 0.3, 0.9
Group.waitTime = 180, 480

bt0.type = SimpleBroadcastInterface
bt0.transmitSpeed = 2M
bt0.transmitRange = 10

Scenario.nrofHostGroups = 4

# Village 1 — local trail loop
Group1.groupID = v1
Group1.nrofHosts = 11
Group1.movementModel = MapRouteMovement
Group1.routeFile = data/NuuksioSparseTrails/R2_village_1.wkt
Group1.routeType = 1
Group1.speed = 0.3, 0.8
Group1.waitTime = 200, 500

# Village 2
Group2.groupID = v2
Group2.nrofHosts = 11
Group2.movementModel = MapRouteMovement
Group2.routeFile = data/NuuksioSparseTrails/R2_village_2.wkt
Group2.routeType = 1
Group2.speed = 0.3, 0.8
Group2.waitTime = 200, 500

# Village 3
Group3.groupID = v3
Group3.nrofHosts = 11
Group3.movementModel = MapRouteMovement
Group3.routeFile = data/NuuksioSparseTrails/R2_village_3.wkt
Group3.routeType = 1
Group3.speed = 0.3, 0.8
Group3.waitTime = 200, 500

# Rangers / inter-village connectors on long trail path
Group4.groupID = rg
Group4.nrofHosts = 3
Group4.movementModel = MapRouteMovement
Group4.routeFile = data/NuuksioSparseTrails/R2_inter_village.wkt
Group4.routeType = 1
Group4.speed = 0.8, 1.5
Group4.waitTime = 60, 240
Group4.bufferSize = 50M

Events.nrof = 1
Events1.class = MessageEventGenerator
Events1.interval = 90, 240
Events1.size = 50k, 150k
Events1.hosts = 0, 36
Events1.prefix = M

Report.nrofReports = 2
Report.reportDir = reports/
Report.report1 = MessageStatsReport
Report.report2 = ContactTimesReport
